# Non-secret local configuration. In APP_ENV=local/test, the backend reads app
# auth/session config from LOCAL_APP_SECRET_FILE and reads Azure/Langfuse keys
# from these environment variables. In non-local environments, secrets are read
# from AWS Secrets Manager using the names below.
APP_ENV=local
AWS_REGION=eu-west-2
SECRETS_STAGE=dev

# Optional local AWS credentials for Docker Compose only.
# Leave these unset in ECS so the backend uses its task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

APP_SECRET_NAME=/dstrmaysam-healthcare-knowledge-multi-agent-dev/app
AZURE_OPENAI_SECRET_NAME=/dstrmaysam-healthcare-knowledge-multi-agent-dev/azure-openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_GENERATION_API=chat_completions
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
LANGFUSE_SECRET_NAME=/dstrmaysam-healthcare-knowledge-multi-agent-dev/langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
GUARDIAN_API_KEY=
GUARDIAN_NEWS_REFRESH_SECONDS=300
GUARDIAN_NEWS_PAGE_SIZE=10

S3_BUCKET=dstrmaysam-healthcare-knowledge-multi-agent-dev
S3_RAW_PREFIX=raw/
S3_MANIFEST_KEY=manifests/documents.json

OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=dstrmaysam-healthcare-knowledge-multi-agent-dev
# Chat history backends:
# - postgres: Postgres only
# - dynamodb_postgres: legacy DynamoDB primary, Postgres fallback
# - dynamodb: legacy DynamoDB only
# - memory: process memory only, not durable
CHAT_HISTORY_BACKEND=postgres
DOCUMENT_MANIFEST_CACHE_TTL_SECONDS=300
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300
CHAT_FAST_RAG_ENABLED=false
CHAT_FAST_PLANNED_EXECUTION_ENABLED=true
CHAT_FAST_RAG_MIN_QUERY_TERMS=3
MAX_GRAPH_LLM_CALLS=10
LLM_RETRY_ATTEMPTS=4
LLM_RETRY_INITIAL_SECONDS=1
LLM_RETRY_MAX_SECONDS=20
LLM_CLIENT_MAX_RETRIES=2
SYSTEM_EVAL_RETRY_ATTEMPTS=4
SYSTEM_EVAL_RETRY_INITIAL_SECONDS=1
SYSTEM_EVAL_RETRY_MAX_SECONDS=20
RAG_TOP_K=10
RAG_NEIGHBOR_CHUNKS=1
INGESTION_CHUNK_SIZE=1500
INGESTION_CHUNK_OVERLAP=250
RAG_PARALLEL_SEARCH_ENABLED=true
CHAT_BACKGROUND_HISTORY_SAVE_ENABLED=true
LANGFUSE_BACKGROUND_TRACE_UPDATE_ENABLED=true
CHAT_WARMUP_ENABLED=true
CHAT_WARMUP_LLM_CALL_ENABLED=true
CHAT_WARMUP_RETRIEVAL_ENABLED=true
LOCAL_DATA_DIR=/app/data
CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_COLLECTION=dstrmaysam-healthcare-knowledge-multi-agent

# Local development secret fallback. If this file is missing in APP_ENV=local/test,
# the backend creates it with a generated session secret and the local username/password below.
LOCAL_APP_SECRET_FILE=/app/data/local_app_secret.json

# Local testing overlay only. Set false to stop injecting an extra test admin into
# the loaded app secret. This does not disable LOCAL_APP_SECRET_FILE.
LOCAL_TEST_ADMIN_ENABLED=false
LOCAL_TEST_ADMIN_USERNAME=admin
LOCAL_TEST_ADMIN_PASSWORD=admin123

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=healthcare_agent
POSTGRES_USER=healthcare_agent
POSTGRES_PASSWORD=healthcare_agent_dev
POSTGRES_SSLMODE=disable

# Docker Compose local runtime overrides. These avoid accidental leakage from
# PowerShell/session AWS variables such as POSTGRES_HOST=<rds-endpoint>.
LOCAL_POSTGRES_HOST=postgres
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_DB=healthcare_agent
LOCAL_POSTGRES_USER=healthcare_agent
LOCAL_POSTGRES_PASSWORD=healthcare_agent_dev
LOCAL_POSTGRES_SSLMODE=disable
LOCAL_CHAT_HISTORY_BACKEND=postgres
LOCAL_S3_BUCKET=
LOCAL_S3_RAW_PREFIX=raw/
LOCAL_S3_MANIFEST_KEY=manifests/documents.json
LOCAL_OPENSEARCH_ENDPOINT=
LOCAL_OPENSEARCH_INDEX=dstrmaysam-healthcare-knowledge-multi-agent-dev
LOCAL_TOOL_EXECUTION_MODE=local
LOCAL_MCP_SERVER_URL=http://host.docker.internal:9000/sse
LOCAL_MCP_PROJECT_ID=dstrmaysam-healthcare-knowledge-multi-agent
LOCAL_MCP_TOOL_TIMEOUT_SECONDS=30
LOCAL_MCP_TOOL_FALLBACK_TO_LOCAL=false

DETERMINISTIC_LOOKUP_ENABLED=true
DETERMINISTIC_LOOKUP_MULTIPART_FIRST_ENABLED=false

# Local tool execution defaults. In AWS mode, these values are read from the app
# secret in Secrets Manager, not from ECS task environment variables.
TOOL_EXECUTION_MODE=local
#MCP_SERVER_URL=http://mcp-tools:8000/sse
MCP_SERVER_URL=http://host.docker.internal:9000/sse
MCP_PROJECT_ID=dstrmaysam-healthcare-knowledge-multi-agent
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_TOOL_FALLBACK_TO_LOCAL=false

# Twilio WhatsApp channel adapter.
# Local mode reads these from env. AWS mode reads the same values from the app
# secret in Secrets Manager using lower-case keys shown in README/docs.
TWILIO_WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_WEBHOOK_URL=
TWILIO_WHATSAPP_ASYNC_ENABLED=false
TWILIO_WHATSAPP_ALLOW_UNMAPPED=false
TWILIO_WHATSAPP_DEFAULT_ROLES=staff
TWILIO_WHATSAPP_DEFAULT_DEPARTMENTS=
TWILIO_WHATSAPP_USERS={}
TWILIO_WHATSAPP_MAX_REPLY_CHARS=1400

BACKEND_URL=http://backend:8000
