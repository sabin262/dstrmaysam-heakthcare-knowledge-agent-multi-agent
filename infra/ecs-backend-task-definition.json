{
  "family": "dstrmaysam-healthcare-knowledge-multi-agent-dev-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<account-id>:role/dstrmaysam-hkm-dev-ecs-exec-role",
  "taskRoleArn": "arn:aws:iam::<account-id>:role/dstrmaysam-hkm-dev-backend-task-role",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "<account-id>.dkr.ecr.<region>.amazonaws.com/dstrmaysam-healthcare-knowledge-multi-agent-dev:backend-latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "APP_ENV", "value": "dev"},
        {"name": "AWS_REGION", "value": "<region>"},
        {"name": "SECRETS_STAGE", "value": "dev"},
        {"name": "APP_SECRET_NAME", "value": "/dstrmaysam-healthcare-knowledge-multi-agent-dev/app"},
        {"name": "AZURE_OPENAI_SECRET_NAME", "value": "/dstrmaysam-healthcare-knowledge-multi-agent-dev/azure-openai"},
        {"name": "AZURE_OPENAI_DEPLOYMENT", "value": "gpt-4.1-mini"},
        {"name": "AZURE_OPENAI_GENERATION_API", "value": "chat_completions"},
        {"name": "LANGFUSE_SECRET_NAME", "value": "/dstrmaysam-healthcare-knowledge-multi-agent-dev/langfuse"},
        {"name": "S3_BUCKET", "value": "dstrmaysam-healthcare-knowledge-multi-agent-dev"},
        {"name": "S3_RAW_PREFIX", "value": "raw/"},
        {"name": "S3_MANIFEST_KEY", "value": "manifests/documents.json"},
        {"name": "OPENSEARCH_ENDPOINT", "value": "https://<collection-id>.<region>.aoss.amazonaws.com"},
        {"name": "OPENSEARCH_INDEX", "value": "dstrmaysam-healthcare-knowledge-multi-agent-dev"},
        {"name": "CHAT_HISTORY_BACKEND", "value": "postgres"},
        {"name": "POSTGRES_HOST", "value": "<rds-endpoint>"},
        {"name": "POSTGRES_PORT", "value": "5432"},
        {"name": "POSTGRES_DB", "value": "healthcare_agent"},
        {"name": "POSTGRES_USER", "value": "healthcare_agent"},
        {"name": "POSTGRES_SSLMODE", "value": "require"},
        {"name": "DOCUMENT_MANIFEST_CACHE_TTL_SECONDS", "value": "300"},
        {"name": "LANGFUSE_PROMPT_CACHE_TTL_SECONDS", "value": "300"},
        {"name": "CHAT_FAST_RAG_ENABLED", "value": "false"},
        {"name": "CHAT_FAST_PLANNED_EXECUTION_ENABLED", "value": "true"},
        {"name": "CHAT_FAST_RAG_MIN_QUERY_TERMS", "value": "3"},
        {"name": "MAX_GRAPH_LLM_CALLS", "value": "10"},
        {"name": "LLM_RETRY_ATTEMPTS", "value": "4"},
        {"name": "LLM_RETRY_INITIAL_SECONDS", "value": "1"},
        {"name": "LLM_RETRY_MAX_SECONDS", "value": "20"},
        {"name": "LLM_CLIENT_MAX_RETRIES", "value": "2"},
        {"name": "SYSTEM_EVAL_RETRY_ATTEMPTS", "value": "4"},
        {"name": "SYSTEM_EVAL_RETRY_INITIAL_SECONDS", "value": "1"},
        {"name": "SYSTEM_EVAL_RETRY_MAX_SECONDS", "value": "20"},
        {"name": "RAG_TOP_K", "value": "10"},
        {"name": "RAG_NEIGHBOR_CHUNKS", "value": "1"},
        {"name": "INGESTION_CHUNK_SIZE", "value": "1500"},
        {"name": "INGESTION_CHUNK_OVERLAP", "value": "250"},
        {"name": "RAG_PARALLEL_SEARCH_ENABLED", "value": "true"},
        {"name": "CHAT_BACKGROUND_HISTORY_SAVE_ENABLED", "value": "true"},
        {"name": "LANGFUSE_BACKGROUND_TRACE_UPDATE_ENABLED", "value": "true"},
        {"name": "CHAT_WARMUP_ENABLED", "value": "true"},
        {"name": "CHAT_WARMUP_LLM_CALL_ENABLED", "value": "true"},
        {"name": "CHAT_WARMUP_RETRIEVAL_ENABLED", "value": "true"},
        {"name": "DETERMINISTIC_LOOKUP_ENABLED", "value": "true"},
        {"name": "DETERMINISTIC_LOOKUP_MULTIPART_FIRST_ENABLED", "value": "false"},
        {"name": "LOCAL_TEST_ADMIN_ENABLED", "value": "false"},
        {"name": "GUARDIAN_NEWS_REFRESH_SECONDS", "value": "300"},
        {"name": "GUARDIAN_NEWS_PAGE_SIZE", "value": "10"}
      ],
      "secrets": [
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "<rds-master-secret-arn>:password::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/dstrmaysam-healthcare-knowledge-multi-agent-dev/backend",
          "awslogs-region": "<region>",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
