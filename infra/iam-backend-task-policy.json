{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRequiredSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:eu-west-2:666127452756:secret:/dstrmaysam-healthcare-knowledge-multi-agent/dev/app-*",
        "arn:aws:secretsmanager:eu-west-2:666127452756:secret:/dstrmaysam-healthcare-knowledge-multi-agent/dev/azure-openai-*",
        "arn:aws:secretsmanager:eu-west-2:666127452756:secret:/dstrmaysam-healthcare-knowledge-multi-agent/dev/langfuse-*",
        "arn:aws:secretsmanager:eu-west-2:666127452756:secret:/dstrmaysam-healthcare-knowledge-multi-agent/dev/postgres-*"
      ]
    },
    {
      "Sid": "WriteAppUserSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:PutSecretValue",
      "Resource": "arn:aws:secretsmanager:eu-west-2:666127452756:secret:/dstrmaysam-healthcare-knowledge-multi-agent/dev/app-*"
    },
    {
      "Sid": "ReadWriteKnowledgeBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::dstrmaysam-healthcare-knowledge-multi-agent-dev",
        "arn:aws:s3:::dstrmaysam-healthcare-knowledge-multi-agent-dev/*"
      ]
    },
    {
      "Sid": "OpenSearchServerlessAccess",
      "Effect": "Allow",
      "Action": [
        "aoss:APIAccessAll"
      ],
      "Resource": "arn:aws:aoss:eu-west-2:666127452756:collection/p5if6vfqygl1kxrcs568"
    }
  ]
}
