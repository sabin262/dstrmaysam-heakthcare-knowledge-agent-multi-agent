{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRequiredSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:<region>:<account-id>:secret:/dstrmaysam-healthcare-knowledge-multi-agent-dev/app-*",
        "arn:aws:secretsmanager:<region>:<account-id>:secret:/dstrmaysam-healthcare-knowledge-multi-agent-dev/azure-openai-*",
        "arn:aws:secretsmanager:<region>:<account-id>:secret:/dstrmaysam-healthcare-knowledge-multi-agent-dev/langfuse-*"
      ]
    },
    {
      "Sid": "WriteAppUserSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:PutSecretValue",
      "Resource": "arn:aws:secretsmanager:<region>:<account-id>:secret:/dstrmaysam-healthcare-knowledge-multi-agent-dev/app-*"
    },
    {
      "Sid": "ReadWriteKnowledgeBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::dstrmaysam-healthcare-knowledge-multi-agent-dev",
        "arn:aws:s3:::dstrmaysam-healthcare-knowledge-multi-agent-dev/*"
      ]
    },
    {
      "Sid": "OpenSearchServerlessAccess",
      "Effect": "Allow",
      "Action": [
        "aoss:APIAccessAll"
      ],
      "Resource": "arn:aws:aoss:<region>:<account-id>:collection/<collection-id>"
    }
  ]
}
